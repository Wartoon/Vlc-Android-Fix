diff --git a/system/keymaps/touchscreen.xml b/system/keymaps/touchscreen.xml
--- a/system/keymaps/touchscreen.xml
+++ b/system/keymaps/touchscreen.xml
@@ -42,10 +42,17 @@
   </FileManager>
   <FullScreenVideo>
     <touch>
-      <swipe direction="left">StepBack</swipe>
-      <swipe direction="right">StepForward</swipe>
-      <swipe direction="up">ChapterOrBigStepForward</swipe>
-      <swipe direction="down">ChapterOrBigStepBack</swipe>
+      <!-- Kodi Mobile V1: one-finger playback gestures are handled continuously. -->
+      <tap>OSD</tap>
+      <!-- Do not dispatch discrete one-finger swipes after a pan. Horizontal -->
+      <!-- seeking is committed exactly once by CGUIWindowFullScreen on release. -->
+      <swipe direction="left"></swipe>
+      <swipe direction="right"></swipe>
+      <!-- Vertical one-finger swipes are intentionally unmapped here. -->
+      <!-- Kodi Mobile handles them from continuous pan events so the start -->
+      <!-- side can select brightness (left) or volume (right). -->
+      <swipe direction="up"></swipe>
+      <swipe direction="down"></swipe>
       <swipe direction="up" pointers="2">SkipNext</swipe>
       <swipe direction="down" pointers="2">SkipPrevious</swipe>
       <tap pointers="2">Playlist</tap>
