diff --git a/xbmc/video/windows/GUIWindowFullScreen.cpp b/xbmc/video/windows/GUIWindowFullScreen.cpp
--- a/xbmc/video/windows/GUIWindowFullScreen.cpp
+++ b/xbmc/video/windows/GUIWindowFullScreen.cpp
@@ -29,6 +29,7 @@
 #include "windowing/WinSystem.h"
 
 #include <algorithm>
+#include <cmath>
 #include <stdio.h>
 #if defined(TARGET_DARWIN)
 #include "platform/posix/PosixResourceCounter.h"
@@ -252,8 +253,40 @@ EVENT_RESULT CGUIWindowFullScreen::OnMouseEvent(const CPoint& point,
   {
     return g_application.OnAction(CAction(ACTION_ANALOG_SEEK_BACK, 0.5f)) ? EVENT_RESULT_HANDLED : EVENT_RESULT_UNHANDLED;
   }
-  if (event.m_id >= ACTION_GESTURE_NOTIFY && event.m_id <= ACTION_GESTURE_END) // gestures
-    return EVENT_RESULT_UNHANDLED;
+  if (event.m_id == ACTION_GESTURE_NOTIFY)
+  {
+    // Kodi Mobile V1 owns one-finger fullscreen pans. Tell the touch
+    // recognizer that both axes are accepted; ACTION_GESTURE_PAN below
+    // locks each update to its dominant axis.
+    return static_cast<EVENT_RESULT>(EVENT_RESULT_PAN_HORIZONTAL | EVENT_RESULT_PAN_VERTICAL);
+  }
+  if (event.m_id == ACTION_GESTURE_BEGIN || event.m_id == ACTION_GESTURE_END ||
+      event.m_id == ACTION_GESTURE_ABORT)
+  {
+    return EVENT_RESULT_HANDLED;
+  }
+  if (event.m_id == ACTION_GESTURE_PAN)
+  {
+    const float absX = std::abs(event.m_offsetX);
+    const float absY = std::abs(event.m_offsetY);
+    if (absX >= absY && absX > 0.0f)
+    {
+      // Continuous horizontal scrubbing. Direction follows the finger.
+      const int action =
+          event.m_offsetX > 0.0f ? ACTION_ANALOG_SEEK_FORWARD : ACTION_ANALOG_SEEK_BACK;
+      const float amount = std::min(1.0f, absX / 120.0f);
+      g_application.OnAction(CAction(action, amount));
+      return EVENT_RESULT_HANDLED;
+    }
+    if (absY > 0.0f)
+    {
+      // First vertical implementation: up raises and down lowers volume.
+      // Left-side display brightness is kept for a dedicated Android patch.
+      const int action = event.m_offsetY < 0.0f ? ACTION_VOLUME_UP : ACTION_VOLUME_DOWN;
+      g_application.OnAction(CAction(action));
+      return EVENT_RESULT_HANDLED;
+    }
+  }
   return EVENT_RESULT_UNHANDLED;
 }
