+
+      if (absY > absX * 2.0f)
+      {
+        if (m_gestureStartX > width * 4.0f / 7.0f)
+          m_playerGesture = PlayerGesture::Volume;
+        else if (m_gestureStartX < width * 3.0f / 7.0f)
+          m_playerGesture = PlayerGesture::Brightness;
+        else
