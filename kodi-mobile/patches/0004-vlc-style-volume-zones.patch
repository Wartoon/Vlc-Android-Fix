-    if (absX >= absY && absX > 0.0f)
+    const auto& res = CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo();
+    const float width = static_cast<float>(res.iWidth);
+    const float height = static_cast<float>(res.iHeight);
+    if (width <= 0.0f || height <= 0.0f)
+      return EVENT_RESULT_HANDLED;
+
+    m_gestureOffsetX += event.m_offsetX;
+    m_gestureOffsetY += event.m_offsetY;
+
+    if (m_playerGesture == PlayerGesture::Pending)
     {
-      // Continuous horizontal scrubbing. Direction follows the finger.
-      const int action =
