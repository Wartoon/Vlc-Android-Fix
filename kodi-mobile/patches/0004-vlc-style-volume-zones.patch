diff --git a/xbmc/video/windows/GUIWindowFullScreen.h b/xbmc/video/windows/GUIWindowFullScreen.h
--- a/xbmc/video/windows/GUIWindowFullScreen.h
+++ b/xbmc/video/windows/GUIWindowFullScreen.h
@@ -11,6 +11,7 @@
 #include "guilib/GUIWindow.h"
 
 #include <chrono>
+#include <cstdint>
 
 class CGUIDialog;
@@ -31,13 +32,32 @@ protected:
   EVENT_RESULT OnMouseEvent(const CPoint& point, const KODI::MOUSE::CMouseEvent& event) override;
 
 private:
+  enum class PlayerGesture
+  {
+    None,
+    Pending,
+    Horizontal,
+    Volume,
+    Ignored
+  };
+
   void SeekChapter(int iChapter);
   void ToggleOSD();
   void TriggerOSD();
   CGUIDialog *GetOSD();
+  void ResetPlayerGesture();
 
   bool m_viewModeChanged;
   std::chrono::time_point<std::chrono::steady_clock> m_dwShowViewModeTimeout;
 
   bool m_bShowCurrentTime;
+  PlayerGesture m_playerGesture{PlayerGesture::None};
+  float m_gestureStartX{0.0f};
+  float m_gestureOffsetX{0.0f};
+  float m_gestureOffsetY{0.0f};
+  float m_gestureStartVolume{0.0f};
+  int64_t m_gestureStartTime{0};
+  int64_t m_gestureTargetTime{0};
+  bool m_pausedForScrub{false};
 };
diff --git a/xbmc/video/windows/GUIWindowFullScreen.cpp b/xbmc/video/windows/GUIWindowFullScreen.cpp
--- a/xbmc/video/windows/GUIWindowFullScreen.cpp
+++ b/xbmc/video/windows/GUIWindowFullScreen.cpp
@@ -29,6 +29,10 @@
 #include "video/dialogs/GUIDialogSubtitleSettings.h"
 #include "windowing/WinSystem.h"
 
+#if defined(TARGET_ANDROID)
+#include "platform/android/activity/XBMCApp.h"
+#endif
 #include <algorithm>
+#include <cmath>
 #include <stdio.h>
@@ -270,4 +274,144 @@ EVENT_RESULT CGUIWindowFullScreen::OnMouseEvent(const CPoint& point,
-  if (event.m_id >= ACTION_GESTURE_NOTIFY && event.m_id <= ACTION_GESTURE_END) // gestures
-    return EVENT_RESULT_UNHANDLED;
+  if (event.m_id == ACTION_GESTURE_NOTIFY)
+    return static_cast<EVENT_RESULT>(EVENT_RESULT_PAN_HORIZONTAL | EVENT_RESULT_PAN_VERTICAL);
+
+  auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+
+  if (event.m_id == ACTION_MOUSE_DOUBLE_CLICK)
+  {
+    const auto& res = CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo();
+    const float width = static_cast<float>(res.iWidth);
+    if (width <= 0.0f || !appPlayer->CanSeek())
+      return EVENT_RESULT_UNHANDLED;
+
+    const int64_t now = appPlayer->GetTime();
+    const int64_t minTime = appPlayer->GetMinTime();
+    const int64_t maxTime = appPlayer->GetMaxTime();
+    if (maxTime <= minTime)
+      return EVENT_RESULT_UNHANDLED;
+    if (point.x < width / 3.0f)
+      appPlayer->SeekTime(std::clamp(now - int64_t{10000}, minTime, maxTime));
+    else if (point.x > width * 2.0f / 3.0f)
+      appPlayer->SeekTime(std::clamp(now + int64_t{10000}, minTime, maxTime));
+    else
+      return EVENT_RESULT_UNHANDLED;
+    return EVENT_RESULT_HANDLED;
+  }
+
+  if (event.m_id == ACTION_GESTURE_BEGIN)
+  {
+    ResetPlayerGesture();
+    m_playerGesture = PlayerGesture::Pending;
+    m_gestureStartX = point.x;
+    m_gestureStartTime = appPlayer->GetTime();
+    m_gestureTargetTime = m_gestureStartTime;
+#if defined(TARGET_ANDROID)
+    m_gestureStartVolume = CXBMCApp::GetSystemVolume();
+#endif
+    return EVENT_RESULT_HANDLED;
+  }
+
+  if (event.m_id == ACTION_GESTURE_ABORT)
+  {
+    if (m_playerGesture == PlayerGesture::Horizontal && m_pausedForScrub &&
+        appPlayer->IsPausedPlayback())
+      appPlayer->Pause();
+    ResetPlayerGesture();
+    return EVENT_RESULT_HANDLED;
+  }
+
+  if (event.m_id == ACTION_GESTURE_END)
+  {
+    if (m_playerGesture == PlayerGesture::Horizontal)
+    {
+      const int64_t minTime = appPlayer->GetMinTime();
+      const int64_t maxTime = appPlayer->GetMaxTime();
+      if (appPlayer->CanSeek() && maxTime > minTime)
+        appPlayer->SeekTime(std::clamp(m_gestureTargetTime, minTime, maxTime));
+      if (m_pausedForScrub && appPlayer->IsPausedPlayback())
+        appPlayer->Pause();
+    }
+    ResetPlayerGesture();
+    return EVENT_RESULT_HANDLED;
+  }
+
+  if (event.m_id == ACTION_GESTURE_PAN)
+  {
+    const auto& res = CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo();
+    const float width = static_cast<float>(res.iWidth);
+    const float height = static_cast<float>(res.iHeight);
+    if (width <= 0.0f || height <= 0.0f)
+      return EVENT_RESULT_HANDLED;
+
+    m_gestureOffsetX += event.m_offsetX;
+    m_gestureOffsetY += event.m_offsetY;
+
+    if (m_playerGesture == PlayerGesture::Pending)
+    {
+      const float absX = std::abs(m_gestureOffsetX);
+      const float absY = std::abs(m_gestureOffsetY);
+      if (std::hypot(absX, absY) < height * 0.02f)
+        return EVENT_RESULT_HANDLED;
+
+      if (absY > absX * 1.35f)
+      {
+        if (m_gestureStartX > width * 4.0f / 7.0f)
+          m_playerGesture = PlayerGesture::Volume;
+        else
+          m_playerGesture = PlayerGesture::Ignored;
+      }
+      else
+      {
+        m_playerGesture = PlayerGesture::Horizontal;
+        if (!appPlayer->IsPausedPlayback() && appPlayer->CanPause())
+        {
+          appPlayer->Pause();
+          m_pausedForScrub = true;
+        }
+      }
+    }
+
+    if (m_playerGesture == PlayerGesture::Horizontal)
+    {
+      if (!appPlayer->CanSeek())
+        return EVENT_RESULT_HANDLED;
+      const int64_t minTime = appPlayer->GetMinTime();
+      const int64_t maxTime = appPlayer->GetMaxTime();
+      if (maxTime <= minTime)
+        return EVENT_RESULT_HANDLED;
+      const double gestureFraction = static_cast<double>(m_gestureOffsetX / width);
+      const int64_t jump = static_cast<int64_t>(gestureFraction * 240000.0);
+      m_gestureTargetTime = std::clamp(m_gestureStartTime + jump, minTime, maxTime);
+      return EVENT_RESULT_HANDLED;
+    }
+
+#if defined(TARGET_ANDROID)
+    if (m_playerGesture == PlayerGesture::Volume)
+    {
+      const float delta = -0.5f * m_gestureOffsetY / height;
+      CXBMCApp::SetSystemVolume(std::clamp(m_gestureStartVolume + delta, 0.0f, 1.0f));
+      return EVENT_RESULT_HANDLED;
+    }
+#endif
+
+    if (m_playerGesture == PlayerGesture::Ignored)
+      return EVENT_RESULT_HANDLED;
+  }
   return EVENT_RESULT_UNHANDLED;
 }
+
+void CGUIWindowFullScreen::ResetPlayerGesture()
+{
+  m_playerGesture = PlayerGesture::None;
+  m_gestureStartX = 0.0f;
+  m_gestureOffsetX = 0.0f;
+  m_gestureOffsetY = 0.0f;
+  m_gestureStartVolume = 0.0f;
+  m_gestureStartTime = 0;
+  m_gestureTargetTime = 0;
+  m_pausedForScrub = false;
+}
