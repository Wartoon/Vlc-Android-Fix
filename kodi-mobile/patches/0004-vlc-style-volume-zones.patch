 class CGUIDialog;
 
@@ -31,11 +32,31 @@ protected:
   EVENT_RESULT OnMouseEvent(const CPoint& point, const KODI::MOUSE::CMouseEvent& event) override;
 
 private:
+  enum class PlayerGesture
+  {
+    None,
+    Pending,
+    Horizontal,
+    Volume,
+    Brightness,
+    Ignored
+  };
+
   void SeekChapter(int iChapter);
   void ToggleOSD();
   void TriggerOSD();
   CGUIDialog *GetOSD();
+  void ResetPlayerGesture();
 
   bool m_viewModeChanged;
   std::chrono::time_point<std::chrono::steady_clock> m_dwShowViewModeTimeout;
 
   bool m_bShowCurrentTime;
+  PlayerGesture m_playerGesture{PlayerGesture::None};
+  float m_gestureStartX{0.0f};
+  float m_gestureStartY{0.0f};
+  float m_gestureOffsetX{0.0f};
+  float m_gestureOffsetY{0.0f};
+  float m_gestureStartVolume{0.0f};
+  int64_t m_gestureStartTime{0};
+  int64_t m_gestureTargetTime{0};
+  bool m_resumeAfterScrub{false};
 };
diff --git a/xbmc/video/windows/GUIWindowFullScreen.cpp b/xbmc/video/windows/GUIWindowFullScreen.cpp
