+      const double gestureCm = static_cast<double>(m_gestureOffsetX / dpi * 2.54f);
+      const double verticalInches = std::abs(static_cast<double>(m_gestureOffsetY / dpi));
+      const double coefficient = std::max(1.0, (verticalInches + 0.5) * 2.0);
+      const double magnitude =
+          (600000.0 * std::pow(std::abs(gestureCm) / 8.0, 4.0) + 3000.0) / coefficient;
+      const int64_t jump = static_cast<int64_t>(std::copysign(magnitude, gestureCm));
